# ========================================
# CẤU HÌNH DOCKER - Copy file này thành .env khi chạy Docker
# ========================================

# Chọn database: true = Cloud SQL, false = Local MySQL container
USE_CLOUD_SQL=false

# ========================================
# LOCAL MYSQL CONTAINER (Khi USE_CLOUD_SQL=false)
# ========================================
LOCAL_DB_HOST=db
LOCAL_DB_PORT=3306
LOCAL_DB_USER=bao
LOCAL_DB_PASS=123456
LOCAL_DB_NAME=thongtinmay

# ========================================
# GOOGLE CLOUD SQL (Khi USE_CLOUD_SQL=true)
# ========================================
CLOUD_SQL_HOST=34.158.44.92
CLOUD_SQL_PORT=3306
CLOUD_SQL_USER=root
CLOUD_SQL_PASS=Bao*14092003
CLOUD_SQL_NAME=thongtinmay

# ========================================
# BASE PATH (quan trọng cho URL routing)
# ========================================
# Giờ Docker và XAMPP dùng chung path
BASE_PATH=/CongNgheMoi

# ========================================
# API KEY
# ========================================
API_KEY=a3b9f34f0a7d1a6e5c2b4c1a8e7f23c1
